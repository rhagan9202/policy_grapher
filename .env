# Committed development defaults. DI-1 is local-only and unauthenticated —
# this password is public by construction. See SPEC-001 (Environment Variables)
# and docs/specs/architecture.md#known-weak-points. Change before any shared deployment.
NEO4J_AUTH=neo4j/policygrapher
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=policygrapher
NEO4J_DATABASE=neo4j
GRAPH_RENDER_CAP=300
DATA_DIR=/data/samples
SAMPLE_CSV=dod_policy_references_08122026.csv
AUTO_INGEST=true
API_TOKENS=
CORS_ALLOW_ORIGINS=http://localhost:5173
QUERY_ROW_CAP=1000
QUERY_TIMEOUT_SECONDS=10.0
