# IDE / editor project files
.idea/
.vscode/
*.iml
*.swp

# Agent scratch (subagent-driven-development ledger, briefs, review packages)
.superpowers/

# Claude Code workspace, untracked in full — settings, hooks and worktrees alike.
# `.claude/settings.json` and the docs-sync hook used to be committed so the whole
# repo shared them, but two checkouts on different machines began overwriting each
# other's copies. They are per-checkout now, which means a fresh clone does NOT
# arrive with the pre-commit docs sync — install it locally if you want it.
.claude/

# OS
.DS_Store
Thumbs.db

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/
dist/
build/
.coverage
htmlcov/

# Node
node_modules/
.vite/
frontend/dist/
*.log
*.tsbuildinfo

# Local environment overrides
#
# `.env` used to be committed with a development default so a clean clone ran with
# `docker compose up` and no manual step — see ADR-010, which reverses that. Secrets are
# now generated locally by `scripts/init-env.sh`; a clean clone runs `./scripts/init-env.sh`
# once instead.
.env.local
.env.*.local

# Generated by scripts/init-env.sh — contains real secrets.
.env
