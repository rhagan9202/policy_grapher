NEO4J_AUTH=neo4j/__NEO4J_PASSWORD__
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=__NEO4J_PASSWORD__
NEO4J_DATABASE=neo4j
GRAPH_RENDER_CAP=300
DATA_DIR=/data/samples
SAMPLE_CSV=dod_policy_references_08122026.csv
# Off by default (ADR-019): a first run ingests nothing, and every screen says
# so rather than rendering a blank that reads as failure. Set true to load
# SAMPLE_CSV at startup when the graph is empty.
AUTO_INGEST=false
API_TOKENS=__API_TOKENS__
API_TOKEN=__API_TOKEN__
# Comma-separated extra hosts for Vite's server.allowedHosts.
VITE_ALLOWED_HOSTS=5173--main--hopes-and-dreams--rhagan.coder.sand.uskgc.com
CORS_ALLOW_ORIGINS=http://localhost:5173
# /openapi.json, /docs and /redoc have no authentication of their own; leave off
# unless you accept an anonymous caller enumerating every route.
ENABLE_API_DOCS=false
QUERY_ROW_CAP=1000
QUERY_TIMEOUT_SECONDS=10.0

# Obligation extraction (DI-2 phase 3). "local" points at an Ollama-compatible
# endpoint and is the default — the default stack carries its models (ADR-028),
# and `ollama` is an ordinary compose service that comes up on a plain
# `docker compose up`. "null" extracts nothing and needs no model server; it is
# what `docker-compose.lean.yml` (a second `-f` argument) sets instead, and it
# is still what a bare `uvicorn` run or a test constructing Settings directly
# gets, since compose is the only place this default changed.
# EXTRACTOR_MODEL is part of the extraction cache key, so changing it will not
# reuse another model's cached results.
# Model provenance is constrained to US-published weights — see ADR-020.
EXTRACTOR_ADAPTER=local
EXTRACTOR_MODEL=llama3.1:8b
# http://ollama:11434 from inside compose; localhost:11434 from the host, where
# the extraction ratchet runs. The ollama service publishes on loopback for that.
EXTRACTOR_BASE_URL=http://ollama:11434
# Per model call, not per rebuild. Generous on purpose: on CPU one chunk can take
# minutes, and 120s was short enough to fail a real run on chunk 1 (STORY-058).
EXTRACTOR_TIMEOUT_SECONDS=600

# Embedding (DI-2 phase 6). "local" runs a sentence-transformers model on this
# machine and is the default, so Ask's semantic leg reaches something on a
# plain `docker compose up` (ADR-028); hosted is deliberately not an option
# (ADR-016). The model is recorded on the vector index, and a later run under
# a different one is refused rather than silently mixed.
# "null" produces no vectors and needs no model; it is what
# `docker-compose.lean.yml` sets instead, and what a bare `uvicorn` run or a
# test constructing Settings directly still gets by default.
# "local" needs BACKEND_EXTRAS below set to carry sentence-transformers, or the
# backend refuses to start and names the flag, rather than failing inside a
# later rebuild.
EMBEDDER_ADAPTER=local
EMBEDDER_MODEL=Snowflake/snowflake-arctic-embed-s

# Build-time, not run-time: passed to `uv sync` when the backend and worker images
# are built. `--extra local-embeddings` adds torch and is the default, taking both
# images to about 16.6GB (ADR-029) so EMBEDDER_ADAPTER=local above has something to
# run.
#
# Setting this empty keeps both images at ~399MB (STORY-052, ADR-021's figure), and
# an empty value here really is honoured — compose defaults this key with `-` and
# not `:-` precisely so that emptying it means something. But emptying it *alone*
# leaves EMBEDDER_ADAPTER=local above pointing at a library that is no longer in the
# image, and the backend refuses to start rather than failing mid-rebuild. Set
# EMBEDDER_ADAPTER=null in the same edit, or use `docker-compose.lean.yml`, which
# does both for you and stops the model server as well — see the README.
BACKEND_EXTRAS=--extra local-embeddings

# The rebuild queue (STORY-048). Redis is reached only from inside the compose
# network; unreachable Redis fails the two rebuild routes and nothing else.
REDIS_URL=redis://redis:6379/0
