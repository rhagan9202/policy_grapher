{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/docs-sync-precommit.sh\"",
            "timeout": 660,
            "statusMessage": "Syncing /docs before commit"
          }
        ]
      }
    ]
  }
}
